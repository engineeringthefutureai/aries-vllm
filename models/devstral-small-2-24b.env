# Devstral Small 2 24B Instruct (Mistral, dense 24B, agentic coding) on 2x Arc Pro B60 (TP=2).
# Status: experimental.
# Checkpoint (ships FP8; skip the duplicate consolidated/ copy):
#   hf download mistralai/Devstral-Small-2-24B-Instruct-2512 --local-dir $MODELS_DIR/devstral-small-2-24b --exclude 'consolidated*'
# Mistral recommends temperature 0.15 for agentic use (set it in your client).

MODEL_DIR=devstral-small-2-24b
SERVED_MODEL_NAME=mistralai/Devstral-Small-2-24B-Instruct-2512

# Dense: ~12 GiB weights/card. KV ~80 KB/token/card (measured: 122K-token pool in 9.32 GiB at 0.9).
# 131K needs ~10 GiB/card, so util 0.95 (pool ~137K: one full-length request at a time).
# 262K would need fp8 KV, and this checkpoint has no KV scales (uncalibrated); not recommended.
# Native context is 393K.
MAX_MODEL_LEN=131072
KV_CACHE_DTYPE=auto
GPU_MEMORY_UTIL=0.95
MAX_NUM_BATCHED_TOKENS=2048
PREFIX_CACHING=1

# Text only: skips vision encoder profiling.
LIMIT_MM_PER_PROMPT={"image":0}

TOOL_CALL_PARSER=mistral
