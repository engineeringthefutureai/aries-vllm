# Qwen/Qwen3.8-27B-FP8 on 2x Arc Pro B60 (TP=2). Status: validated (see docs/results.md).
# Checkpoint: huggingface-cli download Qwen/Qwen3.8-27B-FP8 --local-dir $MODELS_DIR/qwen3.8-27b-fp8
# Hybrid model: ~1/4 full-attention layers + Gated DeltaNet (recurrent state).

MODEL_DIR=qwen3.8-27b-fp8
SERVED_MODEL_NAME=Qwen/Qwen3.8-27B

# 98K fits with auto KV + MTP at 0.9 util (KV pool ~111.7K tokens).
# KV_CACHE_DTYPE=fp8 fits 131K, but its uncalibrated scales (1.0) are the prime suspect for
# garbled output in long sessions; not recommended.
MAX_MODEL_LEN=98304
KV_CACHE_DTYPE=auto
GPU_MEMORY_UTIL=0.9

# 8192 gave no prefill gain over 2048 and uses ~0.7 GB more VRAM per card.
MAX_NUM_BATCHED_TOKENS=2048

# vLLM leaves prefix caching off for hybrid models; without it every agent turn re-prefills
# (~41 s vs ~1.7 s for a 15K-token context).
PREFIX_CACHING=1

# MTP head shipped with the checkpoint. Measured with fallback all-reduce: decode 14.7 -> 26.6
# tok/s. Acceptance ~72% on agent output, 88-96% on code.
SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":2}

# Text only: skips vision encoder profiling.
LIMIT_MM_PER_PROMPT={"image":0,"video":0}

# Tool calls (Qwen Code / OpenAI tools) and thinking blocks.
TOOL_CALL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
