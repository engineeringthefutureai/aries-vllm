# Qwen/Qwen3.5-9B (bf16) on 2x Arc Pro B60 (TP=2). Status: experimental.
# Checkpoint: hf download Qwen/Qwen3.5-9B --local-dir $MODELS_DIR/qwen3.5-9b
# Same architecture as Qwen3.8 (hybrid: 1/4 full-attention layers + Gated DeltaNet, MTP head).
# No official FP8 checkpoint; bf16 is ~19.3 GB, ~9.7 GB/card.

MODEL_DIR=qwen3.5-9b
SERVED_MODEL_NAME=Qwen/Qwen3.5-9B

# 8 full-attention layers x 4 KV heads x 256 dim: ~16 KB/token/card (estimate), so the native
# 262K context fits with room to spare.
MAX_MODEL_LEN=262144
KV_CACHE_DTYPE=auto
GPU_MEMORY_UTIL=0.9
MAX_NUM_BATCHED_TOKENS=2048

# vLLM leaves prefix caching off for hybrid models; without it every agent turn re-prefills.
PREFIX_CACHING=1

# MTP head shipped with the checkpoint, as for Qwen3.8.
SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":2}

# Text only: skips vision encoder profiling.
LIMIT_MM_PER_PROMPT={"image":0,"video":0}

TOOL_CALL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
