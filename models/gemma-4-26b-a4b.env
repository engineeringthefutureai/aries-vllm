# Gemma 4 26B A4B (MoE, 128 experts / 8 active, ~4B active) FP8 on 2x Arc Pro B60 (TP=2).
# Status: experimental.
# Checkpoint: hf download RedHatAI/gemma-4-26B-A4B-it-FP8-dynamic --local-dir $MODELS_DIR/gemma-4-26b-a4b-fp8
# bf16 (48.1 GiB) doesn't fit 48 GB. FP8 here is per-channel weights + dynamic per-token
# activations; the XPU FP8 MoE kernels list per-tensor and 128-block only, so vLLM may fall
# back to Triton MoE kernels.

MODEL_DIR=gemma-4-26b-a4b-fp8
SERVED_MODEL_NAME=google/gemma-4-26B-A4B-it

# 25 of 30 layers are sliding-window (1024 tokens); only 5 global layers grow with context
# (2 KV heads, K=V): ~5 KB/token/card (estimate), so the native 262K context should fit.
MAX_MODEL_LEN=262144
KV_CACHE_DTYPE=auto
GPU_MEMORY_UTIL=0.9
MAX_NUM_BATCHED_TOKENS=2048
PREFIX_CACHING=1

# Text only: skips vision and audio encoder profiling.
LIMIT_MM_PER_PROMPT={"image":0,"video":0,"audio":0}

TOOL_CALL_PARSER=gemma4
REASONING_PARSER=gemma4
