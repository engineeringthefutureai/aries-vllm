# Your settings. Copy to .env (gitignored): cp .env.example .env
# Plain KEY=value lines: no quotes, no trailing comments (docker --env-file keeps them verbatim).

# Required. Clients send it as a bearer token. New one: openssl rand -hex 16
VLLM_API_KEY=change-me

# Host directory holding model checkpoints (mounted read-only at /models)
MODELS_DIR=/srv/models

# Model preset: models/<name>.env, everything model-specific (checkpoint dir, context, MTP,
# parsers). Baked into the image too, so docker run works without the repo.
MODEL_PRESET=qwen3.8-27b

# Port the server listens on (host networking)
PORT=8080

# Image: prebuilt on Docker Hub (`docker compose pull`), or `make build` tags it locally.
ARIES_VLLM_IMAGE=engineeringthefuture/aries-vllm
# Tag: `make` uses the version of this checkout (VERSION + base). Plain `docker compose` uses
# latest unless pinned here, e.g. ARIES_VLLM_TAG=0.1.0-llmscaler0.26.0-b2
# ARIES_VLLM_TAG=

# --- optional overrides (defaults shown) -----------------------------------
# Listen address. 0.0.0.0 exposes routes the API key doesn't guard; README, "Network exposure"
# HOST=127.0.0.1
# chunked = SYCL-kernel all-reduce in <=4 MB slices (fast); fallback = SYCL kernels off (slow, safe)
# ARIES_VLLM_CCL_MODE=chunked
# ARIES_VLLM_AR_CHUNK_BYTES=4194304
# Level Zero indices of the two B60s inside the container
# ZE_AFFINITY_MASK=0,1
# Container RAM cap (TP workers use ~5 GB each)
# MEM_LIMIT=20g
# Any preset value can also be overridden here, e.g. MAX_MODEL_LEN=65536
